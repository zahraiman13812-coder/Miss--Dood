# Local example only. Copy to .env.local, which is ignored by Git.
# Never upload .env.local or include it in a project ZIP.
DATABASE_URL=postgresql://postgres:REPLACE_WITH_PASSWORD@127.0.0.1:5432/missdood
DATABASE_SSL=false
PG_POOL_MAX=10

# Required for signed 6-digit email OTP challenges: at least 32 random characters.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_OTP_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS

# Gmail SMTP is currently used by src/lib/otp-mailer.ts.
# Use an individual Gmail app password, never the primary Google account password.
GMAIL_USER=your-store-account@gmail.com
GMAIL_APP_PASSWORD=REPLACE_WITH_NEW_16_CHARACTER_APP_PASSWORD

# Legacy Resend is not used by the OTP route. Do not set RESEND_API_KEY unless another feature needs it.
