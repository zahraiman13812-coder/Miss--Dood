# Copy to .env.local. Never commit real secrets.
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@127.0.0.1:5432/missdood
DATABASE_SSL=false
PG_POOL_MAX=10

# Resend email OTP
RESEND_API_KEY=re_your_new_resend_api_key
EMAIL_FROM=MISS DOOD <login@your-verified-domain.com>
AUTH_OTP_SECRET=generate_a_random_64_character_hex_secret
